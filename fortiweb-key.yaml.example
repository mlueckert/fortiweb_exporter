# Example authentication map for fortiweb_exporter.
#
# Entries are keyed by an arbitrary profile name, referenced via the
# "profile" query parameter on /probe, and define the credentials and which
# probes should run for targets using that profile.
#
# FortiWeb authenticates with "Authorization: <token>" where <token> is the
# base64 encoding of {"username":"...","password":"...","vdom":"..."}.
# The exporter builds this token from username/password. System probes use the
# root VDOM; policy probes discover VDOMs from the "domains" field returned by
# api/v2.0/system/vip and issue a separate request with its own generated
# token for each VDOM.
#
# Credentials can also be supplied (and overridden) per request via the
# "username" and "password" query parameters, e.g.:
#
#   - targets: ['https://fortiweb.example.com']
#     params:
#       profile: ['default']

default:
  username: admin
  password: secret # betterleaks:allow (example value)
  probes:
    include:
      - System/Resource
      - System/Status
      - System/HAStatus
      - System/Interface
      - Policy/Status

# A profile that never runs any probe (useful for temporarily disabling
# scraping without removing the Prometheus job).
disabled:
  probes:
    exclude:
      - System/Resource
      - System/Status
      - System/HAStatus
      - System/Interface
      - Policy/Status
